generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") 
}

model User {
  id        String    @id @default(cuid())
  username  String    @unique
  password  String
  messages  Message[]
  createdAt DateTime  @default(now())
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  createdAt  DateTime @default(now())
  sender     User     @relation(fields: [senderId], references: [id])
}
